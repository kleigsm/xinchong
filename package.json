{
  "name": "xinchong",
  "version": "0.1.0",
  "private": true,
  "description": "芯宠 —— 轻量化桌面情感陪伴小伙伴",
  "author": "高晟铭",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:win": "electron-vite build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}

{
  "_说明": "4 行布局：每行一个动作，拖拽与睡觉只用前 2 格",
  "id": "my-pet",
  "name": "我的角色",
  "sprite": {
    "image": "sprite.png",
    "frameWidth": 128,
    "frameHeight": 128,
    "columns": 4,
    "rows": 4
  },
  "animations": {
    "idle":  { "frames": [0, 1, 2, 3], "fps": 8,  "loop": true },
    "click": { "frames": [4, 5, 6, 7], "fps": 12, "loop": false },
    "drag":  { "frames": [8, 9],       "fps": 6,  "loop": true },
    "sleep": { "frames": [12, 13],     "fps": 2,  "loop": true }
  },
  "lines": {
    "click":    ["诶？", "你好呀", "别戳啦", "嗯？"],
    "drag":     ["要掉下去了！", "轻一点"],
    "idleLong": ["你在忙吗", "发会儿呆"],
    "sleep":    ["呼……呼……"]
  }
}